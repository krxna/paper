        <mxCell id="n24" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n25" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n26" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n27" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n28" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n29" value="&lt;b&gt;Decision matrix&amp;nbsp; X&lt;sub&gt;k&lt;/sub&gt; = [x&lt;sub&gt;k,1&lt;/sub&gt; … x&lt;sub&gt;k,N&lt;/sub&gt;]&lt;sup&gt;T&lt;/sup&gt; ∈ ℝ&lt;sup&gt;N×6&lt;/sup&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;&lt;b&gt;Kalman filter&lt;/b&gt;&amp;nbsp; x̂&lt;sub&gt;j,q&lt;/sub&gt;(t) = x̂&lt;sub&gt;j,q&lt;/sub&gt;(t−Δt) + K[x&lt;sub&gt;j,q&lt;/sub&gt;(t) − x̂&lt;sub&gt;j,q&lt;/sub&gt;(t−Δt)]&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;per-UAV, per-criterion, steady-state gain K = 0.20" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7C9C2;strokeColor=#C0392B;strokeWidth=1.6;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="58" y="288" width="1684" height="52" as="geometry"/></mxCell>
        <mxCell id="n30" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n17" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n31" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n32" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n19" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n33" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n20" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n34" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n21" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n35" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n22" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n36" value="&lt;b&gt;MEREC objective weights&amp;nbsp; w&lt;sub&gt;k&lt;/sub&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;S&lt;sub&gt;j&lt;/sub&gt; = ln[1 + (1/m)Σ&lt;sub&gt;q&lt;/sub&gt;|ln n&lt;sub&gt;j,q&lt;/sub&gt;|]&amp;nbsp;,&amp;nbsp; e&lt;sub&gt;q&lt;/sub&gt; = Σ&lt;sub&gt;j&lt;/sub&gt;|S&lt;sub&gt;j&lt;/sub&gt;&lt;sup&gt;(−q)&lt;/sup&gt; − S&lt;sub&gt;j&lt;/sub&gt;|&amp;nbsp;,&amp;nbsp; w&lt;sub&gt;q&lt;/sub&gt; = e&lt;sub&gt;q&lt;/sub&gt; / Σ&lt;sub&gt;r&lt;/sub&gt; e&lt;sub&gt;r&lt;/sub&gt;&amp;nbsp;,&amp;nbsp; Σ&lt;sub&gt;q&lt;/sub&gt; w&lt;sub&gt;q&lt;/sub&gt; = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7C9C2;strokeColor=#C0392B;strokeWidth=1.6;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="58" y="362" width="1684" height="52" as="geometry"/></mxCell>
        <mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n29" target="n36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n38" value="&lt;b&gt;STAGE 1 &amp;nbsp;—&amp;nbsp; KL-GATED MULTI-CRITERIA FOG-HEAD ELECTION&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;evaluated once per control period Δt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B03A2E;strokeColor=#7B241C;strokeWidth=2.6;fontSize=15;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="58" y="438" width="1684" height="54" as="geometry"/></mxCell>
        <mxCell id="n39" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n36" target="n38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n40" value="&lt;b&gt;Safety / bootstrap trigger?&lt;/b&gt;&lt;br&gt;first election&amp;nbsp; ∨&amp;nbsp; h(t) unavailable&amp;nbsp; ∨&amp;nbsp; SOC&lt;sub&gt;h&lt;/sub&gt; &amp;lt; SOC&lt;sub&gt;min&lt;/sub&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=2;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="670" y="520" width="460" height="104" as="geometry"/></mxCell>
        <mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n38" target="n40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n42" value="&lt;b&gt;Forced re-ranking&lt;/b&gt;&lt;br&gt;gate bypassed — SPOTIS runs unconditionally" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1290" y="538" width="452" height="64" as="geometry"/></mxCell>
        <mxCell id="n43" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n40" target="n42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n44" value="&lt;b&gt;KL gate&lt;/b&gt;&lt;br&gt;D&lt;sub&gt;KL&lt;/sub&gt;(w&lt;sub&gt;k&lt;/sub&gt; ‖ w&lt;sub&gt;k−1&lt;/sub&gt;) = Σ&lt;sub&gt;q&lt;/sub&gt; w&lt;sub&gt;q&lt;/sub&gt;(t) ln[w&lt;sub&gt;q&lt;/sub&gt;(t)/w&lt;sub&gt;q&lt;/sub&gt;(t−Δt)]&amp;nbsp; &amp;gt;&amp;nbsp; θ&lt;sub&gt;KL&lt;/sub&gt; = 0.05 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=2;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="670" y="654" width="460" height="104" as="geometry"/></mxCell>
        <mxCell id="n45" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n40" target="n44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n46" value="&lt;b&gt;Retain h(t) and the previous SPOTIS ordering&lt;/b&gt;&lt;br&gt;SPOTIS skipped — the gate suppresses most re-rankings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="58" y="672" width="452" height="64" as="geometry"/></mxCell>
        <mxCell id="n47" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n44" target="n46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n48" value="&lt;b&gt;SPOTIS ranking&lt;/b&gt;&amp;nbsp;—&amp;nbsp;fixed a-priori bounds [x&lt;sub&gt;q&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;, x&lt;sub&gt;q&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt;] ⇒ rank-reversal free&lt;br&gt;Ψ&lt;sub&gt;j&lt;/sub&gt; = Σ&lt;sub&gt;q&lt;/sub&gt; w&lt;sub&gt;q&lt;/sub&gt; n&lt;sub&gt;j,q&lt;/sub&gt;&amp;nbsp;,&amp;nbsp;&amp;nbsp; f* = arg min&lt;sub&gt;j&lt;/sub&gt; Ψ&lt;sub&gt;j&lt;/sub&gt;&lt;br&gt;the complete ordering is retained as the fog-head failover sequence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE4E1;strokeColor=#C0392B;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="600" y="788" width="600" height="86" as="geometry"/></mxCell>
        <mxCell id="n49" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n44" target="n48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n50" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n42" target="n48"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1516" y="774"/><mxPoint x="1200" y="774"/></Array></mxGeometry></mxCell>
        <mxCell id="n51" value="&lt;b&gt;Handover pays?&lt;/b&gt;&lt;br&gt;minimum tenure met&amp;nbsp; ∧&amp;nbsp; G&lt;sub&gt;h→c&lt;/sub&gt; &amp;gt; C&lt;sub&gt;h→c&lt;/sub&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=2;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="640" y="904" width="520" height="112" as="geometry"/></mxCell>
        <mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n48" target="n51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n53" value="&lt;b&gt;G&lt;sub&gt;h→c&lt;/sub&gt;&lt;/b&gt; = max(0, D&lt;sub&gt;h&lt;/sub&gt;&lt;sup&gt;ctrl&lt;/sup&gt; − D&lt;sub&gt;c&lt;/sub&gt;&lt;sup&gt;ctrl&lt;/sup&gt;) · H/Δt&amp;nbsp;,&amp;nbsp; horizon H&lt;br&gt;&lt;b&gt;C&lt;sub&gt;h→c&lt;/sub&gt;&lt;/b&gt; = T&lt;sub&gt;setup&lt;/sub&gt; + T&lt;sub&gt;sync&lt;/sub&gt;&amp;nbsp;,&amp;nbsp; T&lt;sub&gt;sync&lt;/sub&gt; = (N−1) L&lt;sub&gt;sync&lt;/sub&gt; / TR̄&lt;sub&gt;c&lt;/sub&gt;&lt;sup&gt;UAV&lt;/sup&gt;&lt;br&gt;T&lt;sub&gt;setup&lt;/sub&gt; is charged as a real CPU job on f&lt;sub&gt;c&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F2;strokeColor=#8A8A72;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1290" y="904" width="452" height="112" as="geometry"/></mxCell>
        <mxCell id="n54" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeWidth=1.2;strokeColor=#8A8A72;" edge="1" parent="1" source="n53" target="n51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n55" value="&lt;b&gt;Master Fog Head retained&lt;/b&gt;&lt;br&gt;h(t) unchanged — no controller migration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAD7D2;strokeColor=#C0392B;strokeWidth=1.6;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="220" y="1046" width="600" height="64" as="geometry"/></mxCell>
        <mxCell id="n56" value="&lt;b&gt;Master Fog Head handover&lt;/b&gt;&lt;br&gt;h(t) ← f*, effective once its control job completes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAD7D2;strokeColor=#C0392B;strokeWidth=1.6;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="980" y="1046" width="600" height="64" as="geometry"/></mxCell>
        <mxCell id="n57" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n51" target="n55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n58" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n51" target="n56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n59" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n46" target="n55"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="284" y="1010"/></Array></mxGeometry></mxCell>
        <mxCell id="n60" value="&lt;b&gt;Active Master Fog Head&lt;/b&gt; executes the Stage-2 controller job for each arriving task τ&lt;sub&gt;k&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6C9EC;strokeColor=#6C3FA0;strokeWidth=1.6;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="600" y="1140" width="600" height="44" as="geometry"/></mxCell>
        <mxCell id="n61" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n55" target="n60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n62" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n56" target="n60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n63" value="&lt;b&gt;Resource &amp;amp; queue features&lt;/b&gt;&lt;br&gt;SOC&lt;sub&gt;j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;W̄&lt;sub&gt;j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;T̄&lt;sup&gt;Q&lt;/sup&gt;&lt;sub&gt;k,j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;q̄&lt;sub&gt;j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;M&lt;sub&gt;k,j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;U&lt;sub&gt;k,j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;tier η̃&lt;sub&gt;j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;ME&lt;sub&gt;j&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9E2F5;strokeColor=#6C3FA0;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="58" y="1214" width="548" height="88" as="geometry"/></mxCell>
        <mxCell id="n64" value="&lt;b&gt;Communication &amp;amp; task-processing features&lt;/b&gt;&lt;br&gt;R&lt;sub&gt;k,j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;d̄&lt;sub&gt;i,j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;T̄&lt;sup&gt;u&lt;/sup&gt;&lt;sub&gt;k,j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;T̄&lt;sup&gt;e&lt;/sup&gt;&lt;sub&gt;k,j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;D̄&lt;sub&gt;k,j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;S&lt;sub&gt;k,j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;S̄&lt;sub&gt;k,j&lt;/sub&gt;&amp;nbsp;·&amp;nbsp;Ē&lt;sub&gt;k,j&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9E2F5;strokeColor=#6C3FA0;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="626" y="1214" width="548" height="88" as="geometry"/></mxCell>
        <mxCell id="n65" value="&lt;b&gt;Heuristic anchor features&lt;/b&gt;&lt;br&gt;deadline-feasibility flag&amp;nbsp;·&amp;nbsp;normalised time–energy objective&lt;br&gt;(warm-start signals for behaviour cloning)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9E2F5;strokeColor=#6C3FA0;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1194" y="1214" width="548" height="88" as="geometry"/></mxCell>
        <mxCell id="n66" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n60" target="n63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n67" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n60" target="n64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n68" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n60" target="n65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n69" value="&lt;b&gt;Task-aware state matrix&amp;nbsp; X&lt;sub&gt;k&lt;/sub&gt; = [x&lt;sub&gt;k,1&lt;/sub&gt; … x&lt;sub&gt;k,N&lt;/sub&gt;]&lt;sup&gt;T&lt;/sup&gt; ∈ ℝ&lt;sup&gt;N×18&lt;/sup&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;&lt;b&gt;EMA standardisation&lt;/b&gt;&amp;nbsp; x̃&lt;sub&gt;k,j,m&lt;/sub&gt; = (x&lt;sub&gt;k,j,m&lt;/sub&gt; − μ&lt;sub&gt;m&lt;/sub&gt;) / (σ&lt;sub&gt;m&lt;/sub&gt; + ε)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;exponential moving μ&lt;sub&gt;m&lt;/sub&gt;, σ&lt;sub&gt;m&lt;/sub&gt; (momentum 0.99)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6C9EC;strokeColor=#6C3FA0;strokeWidth=1.6;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="58" y="1332" width="1684" height="58" as="geometry"/></mxCell>
        <mxCell id="n70" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n63" target="n69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n71" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n64" target="n69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n72" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n65" target="n69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n73" value="&lt;b&gt;Admissible as primary?&lt;/b&gt;&lt;br&gt;SOC&lt;sub&gt;j&lt;/sub&gt; ≥ 0.30&amp;nbsp; ∧&amp;nbsp; queue depth &amp;lt; Q&lt;sub&gt;max&lt;/sub&gt;&amp;nbsp; ∧&amp;nbsp; D̂&lt;sub&gt;k,j&lt;/sub&gt; ≤ d&lt;sub&gt;k&lt;/sub&gt; − Δ&lt;sub&gt;adm&lt;/sub&gt; (25 ms)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C3FA0;strokeWidth=2;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="620" y="1420" width="560" height="112" as="geometry"/></mxCell>
        <mxCell id="n74" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n69" target="n73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n75" value="&lt;b&gt;No admissible UAV&lt;/b&gt;&lt;br&gt;task dropped before dispatch — counted as a deadline miss" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD5D0;strokeColor=#C0392B;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1290" y="1438" width="452" height="76" as="geometry"/></mxCell>
        <mxCell id="n76" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n73" target="n75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n77" value="&lt;b&gt;Candidate score&lt;/b&gt;&amp;nbsp; G&lt;sub&gt;k,j&lt;/sub&gt; = α&lt;sub&gt;S&lt;/sub&gt;S̄&lt;sub&gt;k,j&lt;/sub&gt; + α&lt;sub&gt;R&lt;/sub&gt;R&lt;sub&gt;k,j&lt;/sub&gt; − α&lt;sub&gt;U&lt;/sub&gt;U&lt;sub&gt;k,j&lt;/sub&gt; − α&lt;sub&gt;Q&lt;/sub&gt;T̄&lt;sup&gt;Q&lt;/sup&gt;&lt;sub&gt;k,j&lt;/sub&gt; − α&lt;sub&gt;E&lt;/sub&gt;Ē&lt;sub&gt;k,j&lt;/sub&gt; − α&lt;sub&gt;L&lt;/sub&gt;L&lt;sub&gt;k,j&lt;/sub&gt;&lt;br&gt;retain the &lt;b&gt;top-K = 3&lt;/b&gt; admissible UAVs as the primary candidate set 𝒞&lt;sub&gt;k&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9E2F5;strokeColor=#6C3FA0;strokeWidth=1.6;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="1562" width="960" height="74" as="geometry"/></mxCell>
        <mxCell id="n78" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n73" target="n77"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n79" value="&lt;b&gt;STAGE 2 &amp;nbsp;—&amp;nbsp; ATTENTION-ENCODED, PPO-TRAINED FAULT-TOLERANT TASK ROUTING&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;evaluated per arriving task τ&lt;sub&gt;k&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B3490;strokeColor=#3E2166;strokeWidth=2.6;fontSize=15;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="58" y="1666" width="1684" height="54" as="geometry"/></mxCell>
        <mxCell id="n80" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n77" target="n79"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n81" value="&lt;b&gt;Permutation-invariant self-attention encoder&lt;/b&gt;&lt;br&gt;3 layers&amp;nbsp;·&amp;nbsp;8 heads&amp;nbsp;·&amp;nbsp;d&lt;sub&gt;model&lt;/sub&gt; = 128&amp;nbsp;·&amp;nbsp;FF 256&amp;nbsp;·&amp;nbsp;no positional encoding&lt;br&gt;H&lt;sub&gt;k&lt;/sub&gt; = [h&lt;sub&gt;k,1&lt;/sub&gt; … h&lt;sub&gt;k,N&lt;/sub&gt;]&lt;sup&gt;T&lt;/sup&gt;&amp;nbsp;,&amp;nbsp;&amp;nbsp; context c&lt;sub&gt;k&lt;/sub&gt; = (1/N) Σ&lt;sub&gt;j&lt;/sub&gt; h&lt;sub&gt;k,j&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C3FA0;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="58" y="1750" width="548" height="100" as="geometry"/></mxCell>
        <mxCell id="n82" value="&lt;b&gt;Actor — primary selection&lt;/b&gt;&lt;br&gt;z&lt;sup&gt;p&lt;/sup&gt;&lt;sub&gt;k,j&lt;/sub&gt; = MLP&lt;sub&gt;p&lt;/sub&gt;([h&lt;sub&gt;k,j&lt;/sub&gt; ‖ c&lt;sub&gt;k&lt;/sub&gt;]), masked to 𝒞&lt;sub&gt;k&lt;/sub&gt;&lt;br&gt;π&lt;sub&gt;p&lt;/sub&gt;(f&lt;sub&gt;j&lt;/sub&gt;|s&lt;sub&gt;k&lt;/sub&gt;) = softmax(z&lt;sup&gt;p&lt;/sup&gt;)&amp;nbsp; ⇒&amp;nbsp; &lt;b&gt;f&lt;sub&gt;p&lt;/sub&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C3FA0;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="626" y="1750" width="548" height="100" as="geometry"/></mxCell>
        <mxCell id="n83" value="&lt;b&gt;Actor — backup selection&lt;/b&gt;&lt;br&gt;z&lt;sup&gt;b&lt;/sup&gt;&lt;sub&gt;k,j&lt;/sub&gt; = MLP&lt;sub&gt;b&lt;/sub&gt;([h&lt;sub&gt;k,j&lt;/sub&gt; ‖ c&lt;sub&gt;k&lt;/sub&gt; ‖ h&lt;sub&gt;k,f&lt;sub&gt;p&lt;/sub&gt;&lt;/sub&gt;])&lt;br&gt;f&lt;sub&gt;b&lt;/sub&gt; ≠ f&lt;sub&gt;p&lt;/sub&gt;&amp;nbsp; ∧&amp;nbsp; SOC&lt;sub&gt;j&lt;/sub&gt; ≥ 0.15&amp;nbsp; ⇒&amp;nbsp; &lt;b&gt;f&lt;sub&gt;b&lt;/sub&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C3FA0;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1194" y="1750" width="548" height="100" as="geometry"/></mxCell>
        <mxCell id="n84" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n79" target="n81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n85" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n81" target="n82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n86" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.8;strokeColor=#6C3FA0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n82" target="n83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n87" value="&lt;b&gt;Critic &amp;amp; PPO update&lt;/b&gt;&amp;nbsp; V&lt;sub&gt;φ&lt;/sub&gt;(c&lt;sub&gt;k&lt;/sub&gt;)&amp;nbsp;·&amp;nbsp;GAE(γ = 0.99, λ = 0.95)&lt;br&gt;clipped surrogate ε&lt;sub&gt;p&lt;/sub&gt; = 0.20&amp;nbsp;,&amp;nbsp; L = −L&lt;sup&gt;CLIP&lt;/sup&gt; + 0.50 L&lt;sup&gt;V&lt;/sup&gt; − 0.01 ℋ(π&lt;sub&gt;θ&lt;/sub&gt;)&lt;br&gt;Adam 3×10&lt;sup&gt;−4&lt;/sup&gt;&amp;nbsp;·&amp;nbsp;4 passes per trajectory&amp;nbsp;·&amp;nbsp;gradient norm ≤ 0.5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9E2F5;strokeColor=#6C3FA0;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="58" y="1880" width="826" height="82" as="geometry"/></mxCell>
        <mxCell id="n88" value="&lt;b&gt;Dispatch&lt;/b&gt;&amp;nbsp; a&lt;sub&gt;k&lt;/sub&gt; = (f&lt;sub&gt;p&lt;/sub&gt;, f&lt;sub&gt;b&lt;/sub&gt;)&lt;br&gt;payload uploaded IoT → f&lt;sub&gt;p&lt;/sub&gt; directly&amp;nbsp;·&amp;nbsp;f&lt;sub&gt;b&lt;/sub&gt; held, no payload transmitted&lt;br&gt;dual-queue EDF per UAV: the backup queue preempts the primary queue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F4F4;strokeColor=#1F8A8A;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="916" y="1880" width="826" height="82" as="geometry"/></mxCell>
