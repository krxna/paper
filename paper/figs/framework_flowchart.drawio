        <mxCell id="n20" value="&lt;b&gt;D&lt;sub&gt;j&lt;/sub&gt;&lt;sup&gt;ctrl&lt;/sup&gt;(t) ↓&lt;/b&gt;&lt;br&gt;projected controller-service delay (ms)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE4E1;strokeColor=#C0392B;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="910" y="186" width="264" height="74" as="geometry"/></mxCell>
        <mxCell id="n21" value="&lt;b&gt;W&lt;sub&gt;j&lt;/sub&gt;(t) ↓&lt;/b&gt;&lt;br&gt;pending workload (cycles)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE4E1;strokeColor=#C0392B;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1194" y="186" width="264" height="74" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;ECT&lt;sub&gt;j&lt;/sub&gt;(t) ↑&lt;/b&gt;&lt;br&gt;energy coverage time (s)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE4E1;strokeColor=#C0392B;strokeWidth=1.6;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1478" y="186" width="264" height="74" as="geometry"/></mxCell>
