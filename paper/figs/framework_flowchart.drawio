        <mxCell id="n2" value="&lt;b&gt;IoT devices&lt;/b&gt; 𝓘 = {i&lt;sub&gt;1&lt;/sub&gt; … i&lt;sub&gt;M&lt;/sub&gt;}&lt;br&gt;positions &lt;b&gt;p&lt;/b&gt;&lt;sub&gt;i&lt;/sub&gt; = (x&lt;sub&gt;i&lt;/sub&gt;, y&lt;sub&gt;i&lt;/sub&gt;, 0), Tx power P&lt;sub&gt;i&lt;/sub&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C8963E;strokeWidth=1.6;fontSize=10;fontColor=#6B4A12;" vertex="1" parent="1"><mxGeometry x="58" y="10" width="232" height="58" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;UAV hardware&lt;/b&gt;&lt;br&gt;ν&lt;sub&gt;j&lt;/sub&gt;&lt;sup&gt;cpu&lt;/sup&gt;, C&lt;sub&gt;j&lt;/sub&gt;&lt;sup&gt;MIPS&lt;/sup&gt;, ς&lt;sub&gt;j&lt;/sub&gt;, MP/MS, E&lt;sub&gt;j&lt;/sub&gt;&lt;sup&gt;init&lt;/sup&gt;, λ&lt;sub&gt;j&lt;/sub&gt;, μ&lt;sub&gt;j&lt;/sub&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C8963E;strokeWidth=1.6;fontSize=10;fontColor=#6B4A12;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="232" height="58" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;UAV mobility&lt;/b&gt;&lt;br&gt;&lt;b&gt;q&lt;/b&gt;&lt;sub&gt;j&lt;/sub&gt;(t) = (x&lt;sub&gt;j&lt;/sub&gt;, y&lt;sub&gt;j&lt;/sub&gt;, z&lt;sub&gt;j&lt;/sub&gt;), speed V&lt;sub&gt;j&lt;/sub&gt;(t)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C8963E;strokeWidth=1.6;fontSize=10;fontColor=#6B4A12;" vertex="1" parent="1"><mxGeometry x="542" y="10" width="232" height="58" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Task stream&lt;/b&gt; 𝒯&lt;br&gt;τ&lt;sub&gt;k&lt;/sub&gt; = (a&lt;sub&gt;k&lt;/sub&gt;, s&lt;sub&gt;k&lt;/sub&gt;, l&lt;sub&gt;k&lt;/sub&gt;, d&lt;sub&gt;k&lt;/sub&gt;), Poisson arrivals" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C8963E;strokeWidth=1.6;fontSize=10;fontColor=#6B4A12;" vertex="1" parent="1"><mxGeometry x="784" y="10" width="232" height="58" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;Air-to-ground channel&lt;/b&gt;&lt;br&gt;B, N&lt;sub&gt;0&lt;/sub&gt;, υ&lt;sub&gt;1&lt;/sub&gt;, υ&lt;sub&gt;2&lt;/sub&gt; ⇒ g&lt;sub&gt;ij&lt;/sub&gt;(t), TR&lt;sub&gt;ij&lt;/sub&gt;(t)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C8963E;strokeWidth=1.6;fontSize=10;fontColor=#6B4A12;" vertex="1" parent="1"><mxGeometry x="1026" y="10" width="232" height="58" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Node live state&lt;/b&gt;&lt;br&gt;E&lt;sub&gt;j&lt;/sub&gt;&lt;sup&gt;res&lt;/sup&gt;, SOC&lt;sub&gt;j&lt;/sub&gt;, ME&lt;sub&gt;j&lt;/sub&gt;, Q&lt;sub&gt;j&lt;/sub&gt;&lt;sup&gt;p&lt;/sup&gt; / Q&lt;sub&gt;j&lt;/sub&gt;&lt;sup&gt;b&lt;/sup&gt; / Q&lt;sub&gt;j&lt;/sub&gt;&lt;sup&gt;ctrl&lt;/sup&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C8963E;strokeWidth=1.6;fontSize=10;fontColor=#6B4A12;" vertex="1" parent="1"><mxGeometry x="1268" y="10" width="232" height="58" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;Control period&lt;/b&gt;&lt;br&gt;Δt = 100 ms  (10 Hz control loop)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C8963E;strokeWidth=1.6;fontSize=10;fontColor=#6B4A12;" vertex="1" parent="1"><mxGeometry x="1510" y="10" width="232" height="58" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;UAV fog swarm&amp;nbsp; ℱ = {f&lt;sub&gt;1&lt;/sub&gt;, f&lt;sub&gt;2&lt;/sub&gt;, …, f&lt;sub&gt;N&lt;/sub&gt;}&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;N heterogeneous fog UAVs, capability tiers from CE&lt;sub&gt;j&lt;/sub&gt;&lt;sup&gt;eff&lt;/sup&gt;&lt;br&gt;Master Fog Head h(t) ∈ ℱ hosts the control plane&amp;nbsp;·&amp;nbsp;task payload travels IoT → executor &lt;b&gt;directly&lt;/b&gt;, never through the head" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E4F2E4;strokeColor=#3E8E4E;strokeWidth=2.2;fontSize=12;fontColor=#1E5E2A;" vertex="1" parent="1"><mxGeometry x="450" y="92" width="900" height="66" as="geometry"/></mxCell>
